# Copie este archivo como .env y complete con sus valores reales.
# NUNCA suba el archivo .env real al repositorio.

# --- Base de datos (PostgreSQL, decidido en Entrega 2 - ver docs/entrega-2/Bitacora-IA.md) ---
# En producción (Neon) basta con DATABASE_URL y se ignoran las DB_* de abajo:
# DATABASE_URL=postgresql://usuario:contrasena@servidor/basedatos?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inventario_laboratorio
DB_USER=usuario_app
DB_PASSWORD=cambie_esta_contrasena

# --- Aplicación ---
APP_ENV=development          # production en Render
APP_PORT=8080
APP_SECRET=cambie_esta_clave_secreta