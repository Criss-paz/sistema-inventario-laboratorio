        <mxCell id="leyenda" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; clave primaria (subrayada, fondo azul) &amp;#160;·&amp;#160; &lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; clave foránea (cursiva, fondo ámbar) &amp;#160;·&amp;#160; &lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;UQ&lt;/b&gt;&lt;/font&gt; UNIQUE &amp;#160;·&amp;#160; &lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;CK&lt;/b&gt;&lt;/font&gt; CHECK&lt;br&gt;Todas las columnas son &lt;b&gt;NOT NULL&lt;/b&gt; salvo que se indique &lt;b&gt;NULL&lt;/b&gt;. &lt;b&gt;DEF&lt;/b&gt; = valor por defecto.&lt;br&gt;Pata de gallo = lado &lt;b&gt;N&lt;/b&gt; de la relación 1:N. Toda FK usa &lt;b&gt;ON UPDATE CASCADE&lt;/b&gt;; sobre cada línea se indica su ON DELETE.&lt;br&gt;Azul = ON DELETE RESTRICT (historial protegido) &amp;#160;·&amp;#160; Ámbar = ON DELETE CASCADE (solo tablas puente N:M).&lt;br&gt;&lt;b&gt;15 tablas.&lt;/b&gt; Coincide con sql/ddl/001_schema.sql más 002_devolucion.sql y 003_examen_estado.sql (id_movimiento_origen, motivo y su CHECK; estado de examen_laboratorio), 004_correccion_entrada.sql, 005_numero_documento.sql (numero_documento), 006_permisos.sql y 007_bitacora.sql (15 tablas)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=#1F4E79;fillColor=#F5F8FC;spacingLeft=10;spacingTop=6;fontSize=11;rounded=1;" vertex="1" parent="1"><mxGeometry x="1000" y="980" width="840" height="130" as="geometry"/></mxCell>
        <mxCell id="titulo" value="MODELO RELACIONAL — Sistema de Inventario, Laboratorio Privado Quetzaltenango (actualizado en la Entrega 4)" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="34" as="geometry"/></mxCell>
